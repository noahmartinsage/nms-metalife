{
  "name": "RedPacket",
  "type": "object",
  "properties": {
    "sender_address": {
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "remaining_amount": {
      "type": "number"
    },
    "packet_count": {
      "type": "number"
    },
    "claimed_count": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "lucky",
        "average",
        "merchant"
      ],
      "default": "lucky"
    },
    "message": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "claimed",
        "expired"
      ],
      "default": "active"
    }
  },
  "required": [
    "sender_address",
    "total_amount",
    "packet_count"
  ]
}
