# ---------- 服务端（server/index.mjs） ----------
PORT=8787
HOST=127.0.0.1

# 鉴权：生产必须开严格模式（关闭 demo 兜底）
NMS_AUTH_STRICT=1
# 令牌签名密钥，务必替换为随机长串：openssl rand -base64 48
NMS_JWT_SECRET=change-me-to-a-long-random-string
# 令牌有效期（秒），默认 12 小时
NMS_TOKEN_TTL=43200

# 对账定时任务（默认每日 00:00）
RECONCILE_HOUR=0
# 启动时先跑一次对账
RECONCILE_ON_BOOT=0
# 告警 webhook（企业微信/飞书/Slack 通用 JSON）
ALERT_WEBHOOK=

# 大模型调用（可选）
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- 前端 ----------
# local = 浏览器 localStorage（默认，离线可用）
# server = 走 HTTP 服务端（SQLite）
VITE_API_MODE=server
VITE_API_BASE=/api
