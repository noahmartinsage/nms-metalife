# ---------- 服务端（server/index.mjs） ----------
PORT=8787
HOST=127.0.0.1

# 鉴权：生产必须开严格模式（关闭 demo 兜底）
NMS_AUTH_STRICT=1
# 令牌签名密钥，务必替换为随机长串：openssl rand -base64 48
NMS_JWT_SECRET=change-me-to-a-long-random-string
# 令牌有效期（秒），默认 12 小时
NMS_TOKEN_TTL=43200

# 对账定时任务（默认每日 00:00）
RECONCILE_HOUR=0
# 启动时先跑一次对账
RECONCILE_ON_BOOT=0
# 告警 webhook（企业微信/飞书/Slack 通用 JSON）
ALERT_WEBHOOK=

# 大模型调用（可选）
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- 前端 ----------
# local = 浏览器 localStorage（默认，离线可用）
# server = 走 HTTP 服务端（SQLite）
VITE_API_MODE=server
VITE_API_BASE=/api

# ---------- 阿里云 KMS（可选，生产推荐） ----------
# 把根密钥托管到云 KMS：本地只保存密文，启动时解密一次
# 详见 docs/aliyun-kms.md
NMS_KMS_KEK_PROVIDER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_KMS_REGION=cn-hangzhou
NMS_KMS_ALIYUN_KEY_ID=
NMS_KMS_ALIYUN_SEALED_KEK=
# 可选：改用云签名（RSA / EC / SM2）
NMS_KMS_SIGNER=
NMS_KMS_ALIYUN_SIGN_KEY_ID=
NMS_KMS_ALIYUN_SIGN_ALGORITHM=ECDSA_SHA_256
ALIYUN_KMS_TIMEOUT_MS=8000
ALIYUN_KMS_RETRIES=2
